{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/session_start_context.py\"",
            "timeout": 15,
            "statusMessage": "Loading project self-learning memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/user_prompt_context.py\"",
            "timeout": 10,
            "statusMessage": "Selecting relevant project memory"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|MultiEdit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/post_tool_learning.py\"",
            "timeout": 10,
            "statusMessage": "Recording code/tool evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/stop_learning.py\"",
            "timeout": 15,
            "statusMessage": "Saving learning candidates"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/auto-commit-push.sh\"",
            "timeout": 600,
            "statusMessage": "Updating changelog and committing changes"
          }
        ]
      }
    ]
  }
}
